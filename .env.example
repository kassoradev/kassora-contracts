# --- RPC -------------------------------------------------------------------
# Robinhood Chain mainnet (chain 4663, Arbitrum Orbit L2, gas = ETH)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Robinhood Chain testnet (chain 46630). Confirm the URL on docs.robinhood.com/chain/connecting
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Deployer --------------------------------------------------------------
# Prefer `--account <keystore>` over a raw key. Only use PRIVATE_KEY for testnet.
PRIVATE_KEY=

# --- Vault parameters (script/Deploy.s.sol) --------------------------------
# USDG on Robinhood Chain mainnet. Testnet: set to a test USDG / mock you control.
ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
VAULT_NAME="Kassora USDG Vault"
VAULT_SYMBOL=kUSDG
OWNER=
CURATOR=
GUARDIAN=
FEE_RECIPIENT=
# seconds; 0 = bootstrap mode (allowed only at deploy), else 1 day .. 2 weeks
INITIAL_TIMELOCK=86400
# in asset units (USDG has 6 decimals). 1_000_000 USDG = 1000000000000
DEPOSITCAP=1000000000000
# virtual-share offset for inflation-attack protection (6 is a sane default for a 6-decimal asset)
DECIMALS_OFFSET=6

# Optional: deploy an ERC4626Strategy adapter pointing at an existing ERC-4626 vault
# (e.g. Spark spUSDG Savings on chain 4663). Leave empty to skip.
TARGET_VAULT=
# Per-strategy cap submitted after deploy (asset units). Requires acceptCap after the timelock.
STRATEGY_CAP=500000000000
